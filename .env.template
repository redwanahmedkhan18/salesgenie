# SalesGenie Enterprise AI Platform - Environment Template
# Copy to .env and fill in real values. NEVER commit the actual .env file.

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database
POSTGRES_USER=salesgenie_admin
POSTGRES_PASSWORD= # REQUIRED - set via secret manager
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=salesgenie_db

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD= # REQUIRED - set via secret manager
REDIS_DB=0

# JWT
JWT_SECRET_KEY= # REQUIRED - 32+ char secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# LLM Provider Keys - REQUIRED for each provider you enable
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Keycloak
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=salesgenie-realm
KEYCLOAK_CLIENT_ID=salesgenie-auth-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# PII Encryption
PII_ENCRYPTION_KEY= # REQUIRED in production - 32+ char key for PII field encryption

# Channel Integrations
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SendGrid
SENDGRID_API_KEY=

# MinIO / Object Storage
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=salesgenie-files

# Sentry
SENTRY_DSN=
