{
  "dashboard": {
    "id": null,
    "title": "SalesGenie - AI Performance",
    "tags": ["salesgenie", "ai", "llm"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Total Tokens Used",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(increase(ai_tokens_used_total[1h]))",
            "format": "time_series"
          }
        ]
      },
      {
        "id": 2,
        "title": "Token Cost (USD)",
        "type": "stat",
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(increase(ai_tokens_used_total[1h])) * 0.0000001",
            "format": "time_series"
          }
        ]
      },
      {
        "id": 3,
        "title": "AI Requests per Minute",
        "type": "stat",
        "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(ai_requests_total[1m]))",
            "format": "time_series"
          }
        ]
      },
      {
        "id": 4,
        "title": "Tokens per Request",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(ai_tokens_used_total[5m])) / sum(rate(ai_requests_total[5m]))",
            "format": "time_series"
          }
        ]
      },
      {
        "id": 5,
        "title": "Token Usage Over Time",
        "type": "graph",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(ai_tokens_used_total[5m])) by (provider)",
            "legendFormat": "{{provider}}",
            "format": "time_series"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Tokens/sec"},
          {"format": "short", "show": false}
        ]
      },
      {
        "id": 6,
        "title": "Request Duration by Provider",
        "type": "graph",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(ai_request_duration_seconds_bucket[5m])) by (provider)",
            "legendFormat": "{{provider}}",
            "format": "time_series"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration (seconds)"},
          {"format": "short", "show": false}
        ]
      },
      {
        "id": 7,
        "title": "Tokens by Model",
        "type": "graph",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(ai_tokens_used_total[5m])) by (model)",
            "legendFormat": "{{model}}",
            "format": "time_series"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Tokens/sec"},
          {"format": "short", "show": false}
        ]
      },
      {
        "id": 8,
        "title": "AI Error Rate",
        "type": "graph",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_errors_total[5m]) / rate(ai_requests_total[5m]) * 100",
            "legendFormat": "{{provider}}",
            "format": "time_series"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Error Rate %"},
          {"format": "short", "show": false}
        ]
      },
      {
        "id": 9,
        "title": "Token Usage by Provider",
        "type": "barchart",
        "gridPos": {"x": 0, "y": 20, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(ai_tokens_used_total[1h])) by (provider)",
            "legendFormat": "{{provider}}",
            "format": "time_series"
          }
        ]
      },
      {
        "id": 10,
        "title": "Cost by Provider",
        "type": "barchart",
        "gridPos": {"x": 6, "y": 20, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(ai_tokens_used_total[1h])) * 0.0000001 by (provider)",
            "legendFormat": "{{provider}}",
            "format": "time_series"
          }
        ]
      }
    ]
  }
}