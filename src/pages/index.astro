---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SalesGenie — Enterprise AI Sales & Support Platform">
  <div id="landing-root"></div>
</Layout>

<script>
  // Landing page is rendered by the React island
  import('../components/islands/LandingPage').then(({ default: LandingPage }) => {
    import('react').then(React => {
      import('react-dom/client').then(({ createRoot }) => {
        const root = createRoot(document.getElementById('landing-root')!);
        root.render(React.createElement(LandingPage));
      });
    });
  });
</script>
