---
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - SalesGenie</title>
</head>
<body style="background: linear-gradient(135deg, #0f1117 0%, #1a1d29 50%, #0f1117 100%); color: white; font-family: Arial, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
  <div style="background: var(--color-card); padding: 40px; border-radius: 16px; border: 1px solid var(--color-border); max-width: 400px; width: 100%;">
    <div style="text-align: center; margin-bottom: 24px;">
      <div style="width: 60px; height: 60px; background: var(--color-primary); color: var(--color-on-primary); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="30" height="30">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12H8m0 0l3-3m3 3l3-3M9 12v6h6v-6"/>
        </svg>
      </div>
      <h2 style="margin: 0 0 8px;">Forgot Password</h2>
      <p style="margin: 0; color: var(--color-muted-foreground);">Enter your email to receive a reset link</p>
    </div>
    
    <div id="form-section">
      <form id="reset-form" style="display: flex; flex-direction: column; gap: 16px;">
        <div>
          <label style="display: block; margin-bottom: 8px; color: var(--color-foreground);">
            Email Address
          </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@company.com"
            required
            style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid var(--color-border); background: var(--color-background); color: var(--color-foreground);"
          />
        </div>
        
        <div id="error" style="display: none; padding: 12px; background: rgba(205,66,63,0.15); border: 1px solid rgba(205,66,63,0.3); border-radius: 8px; color: #cd4239;"></div>
        
        <button type="submit" style="padding: 12px; border-radius: 8px; background: var(--color-primary); color: var(--color-on-primary); border: none; cursor: pointer;">
          Send Reset Link
        </button>
        
        <button type="button" id="back-to-login" style="padding: 10px 20px; background: transparent; color: var(--color-muted-foreground); border: 1px solid var(--color-border); border-radius: 6px; cursor: pointer;">
          Back to Login
        </button>
      </form>
    </div>
    
    <div id="success-section" style="display: none; text-align: center;">
      <div style="padding: 24px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="48" height="48" style="color: #4CAF50; margin-bottom: 16px;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        <h3 style="margin: 0 0 12px;">Reset Link Sent</h3>
        <p style="margin: 0; color: var(--color-muted-foreground);">
          If an account exists with that email, a password reset link has been sent.
        </p>
        <button id="go-to-login" style="margin-top: 16px; padding: 10px 20px; background: var(--color-primary); color: var(--color-on-primary); border: none; border-radius: 6px; cursor: pointer;">
          Go to Login
        </button>
      </div>
    </div>
  </div>
  
  <script is:inline>
    (function() {
      var form = document.getElementById('reset-form');
      var errorEl = document.getElementById('error');
      var formSection = document.getElementById('form-section');
      var successSection = document.getElementById('success-section');
      var backToLogin = document.getElementById('back-to-login');
      var goToLogin = document.getElementById('go-to-login');
      
      function sendReset() {
        var formData = new FormData(form);
        var email = formData.get('email');
        
        if (!email) {
          errorEl.style.display = 'block';
          errorEl.textContent = 'Please enter your email address';
          return;
        }
        
        fetch('/api/v1/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email })
        }).then(function(response) {
          return response.json();
        }).then(function(data) {
          if (data.success) {
            formSection.style.display = 'none';
            successSection.style.display = 'block';
          } else {
            errorEl.style.display = 'block';
            errorEl.textContent = data.message || 'Request failed';
          }
        }).catch(function(err) {
          errorEl.style.display = 'block';
          errorEl.textContent = 'Request failed. Please try again.';
        });
      }
      
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        sendReset();
      });
      
      backToLogin.addEventListener('click', function() {
        window.location.href = '/login';
      });
      
      goToLogin.addEventListener('click', function() {
        window.location.href = '/login';
      });
    })();
  </script>
</body>
</html>