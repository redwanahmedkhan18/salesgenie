---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="SalesGenie Dashboard — AI Operations Center">
  <div id="dashboard-root"></div>
</Layout>

<script type="module">
  import { AuthProvider } from '../../auth/AuthProvider';
  import { ProtectedRoute } from '../../auth/ProtectedRoute';
  import { RoleDashboard } from '../../auth/RoleDashboard';
  import React from 'react';
  import { createRoot } from 'react-dom/client';

  const root = createRoot(document.getElementById('dashboard-root')!);
  root.render(
    React.createElement(AuthProvider, null,
      React.createElement(ProtectedRoute, null,
        React.createElement(RoleDashboard, null)
      )
    )
  );
</script>
