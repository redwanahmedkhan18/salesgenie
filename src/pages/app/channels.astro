---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SalesGenie Channels — WhatsApp & Communication Channels">
  <div id="channels-root"></div>
</Layout>

<script type="module">
  import { AuthProvider } from '../../auth/AuthProvider';
  import { ProtectedRoute } from '../../auth/ProtectedRoute';
  import { ChannelManagement } from '../../components/islands/channels/ChannelManagement';
  import React from 'react';
  import { createRoot } from 'react-dom/client';

  const root = createRoot(document.getElementById('channels-root')!);
  root.render(
    React.createElement(AuthProvider, null,
      React.createElement(ProtectedRoute, { requiredRoles: ['org_admin', 'super_admin', 'workspace_admin', 'knowledge_manager'] },
        React.createElement(ChannelManagement, null)
      )
    )
  );
</script>
