---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="SalesGenie Workflows — Workflow Builder">
  <div id="workflows-root"></div>
</Layout>

<script type="module">
  import { AuthProvider } from '../../auth/AuthProvider';
  import { ProtectedRoute } from '../../auth/ProtectedRoute';
  import WorkflowBuilder from '../../components/islands/WorkflowBuilder';
  import React from 'react';
  import { createRoot } from 'react-dom/client';

  const root = createRoot(document.getElementById('workflows-root')!);
  root.render(
    React.createElement(AuthProvider, null,
      React.createElement(ProtectedRoute, { requiredRoles: ['org_admin', 'super_admin', 'workspace_admin'] },
        React.createElement(WorkflowBuilder, null)
      )
    )
  );
</script>