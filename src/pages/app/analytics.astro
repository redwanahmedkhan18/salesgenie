---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="SalesGenie Analytics — Dashboard">
  <div id="analytics-root"></div>
</Layout>

<script type="module">
  import { AuthProvider } from '../../auth/AuthProvider';
  import { ProtectedRoute } from '../../auth/ProtectedRoute';
  import AnalyticsDashboard from '../../components/islands/AnalyticsDashboard';
  import React from 'react';
  import { createRoot } from 'react-dom/client';

  const root = createRoot(document.getElementById('analytics-root')!);
  root.render(
    React.createElement(AuthProvider, null,
      React.createElement(ProtectedRoute, { requiredRoles: ['sales_manager', 'support_manager', 'org_admin', 'super_admin', 'auditor'] },
        React.createElement(AnalyticsDashboard, null)
      )
    )
  );
</script>