---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SalesGenie Knowledge — Knowledge Base">
  <div id="knowledge-root"></div>
</Layout>

<script type="module">
  import { AuthProvider } from '../../auth/AuthProvider';
  import { ProtectedRoute } from '../../auth/ProtectedRoute';
  import KnowledgeBase from '../../components/islands/KnowledgeBase';
  import React from 'react';
  import { createRoot } from 'react-dom/client';

  const root = createRoot(document.getElementById('knowledge-root')!);
  root.render(
    React.createElement(AuthProvider, null,
      React.createElement(ProtectedRoute, { requiredRoles: ['knowledge_manager', 'sales_manager', 'sales_agent', 'support_manager', 'support_agent', 'org_admin', 'super_admin'] },
        React.createElement(KnowledgeBase, null)
      )
    )
  );
</script>