---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="SalesGenie Settings — Administration">
  <div id="settings-root"></div>
</Layout>

<script type="module">
  import { AuthProvider } from '../../auth/AuthProvider';
  import { ProtectedRoute } from '../../auth/ProtectedRoute';
  import SettingsAdmin from '../../components/islands/SettingsAdmin';
  import React from 'react';
  import { createRoot } from 'react-dom/client';

  const root = createRoot(document.getElementById('settings-root')!);
  root.render(
    React.createElement(AuthProvider, null,
      React.createElement(ProtectedRoute, { requiredRoles: ['org_admin', 'super_admin', 'workspace_admin'] },
        React.createElement(SettingsAdmin, null)
      )
    )
  );
</script>