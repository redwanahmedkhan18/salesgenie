---
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - SalesGenie</title>
</head>
<body style="background: linear-gradient(135deg, #0f1117 0%, #1a1d29 50%, #0f1117 100%); color: white; font-family: Arial, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
  <div style="background: var(--color-card); padding: 40px; border-radius: 16px; border: 1px solid var(--color-border); max-width: 400px; width: 100%;">
    <div style="text-align: center; margin-bottom: 24px;">
      <div style="width: 60px; height: 60px; background: var(--color-primary); color: var(--color-on-primary); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="30" height="30">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2h-4v-2h4zm0-8h.01v2h-.01V7zm0 12v2h.01v-2h-.01zm0-8h4v2h-4V7z"/>
        </svg>
      </div>
      <h2 style="margin: 0 0 8px;">Reset Password</h2>
      <p style="margin: 0; color: var(--color-muted-foreground);">Enter your new password</p>
    </div>
    
    <div id="token-section" style="display: none;">
      <form id="reset-form" style="display: flex; flex-direction: column; gap: 16px;">
        <div>
          <label style="display: block; margin-bottom: 8px; color: var(--color-foreground);">
            New Password
          </label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter new password"
            required
            minlength="8"
            style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid var(--color-border); background: var(--color-background); color: var(--color-foreground);"
          />
        </div>
        <div>
          <label style="display: block; margin-bottom: 8px; color: var(--color-foreground);">
            Confirm Password
          </label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            placeholder="Confirm new password"
            required
            minlength="8"
            style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid var(--color-border); background: var(--color-background); color: var(--color-foreground);"
          />
        </div>
        
        <div id="error" style="display: none; padding: 12px; background: rgba(205,66,63,0.15); border: 1px solid rgba(205,66,63,0.3); border-radius: 8px; color: #cd4239;"></div>
        
        <button type="submit" style="padding: 12px; border-radius: 8px; background: var(--color-primary); color: var(--color-on-primary); border: none; cursor: pointer;">
          Update Password
        </button>
      </form>
    </div>
    
    <div id="no-token" style="display: none; text-align: center;">
      <p style="color: var(--color-muted-foreground);">No reset token found. Use the "Forgot Password" link to request one.</p>
      <button id="go-to-login" style="margin-top: 16px; padding: 8px 16px; background: var(--color-primary); color: var(--color-on-primary); border: none; border-radius: 6px; cursor: pointer;">
        Go to Login
      </button>
    </div>
    
    <div id="error-token" style="display: none; text-align: center;">
      <p id="error-token-message" style="color: var(--color-muted-foreground); margin-bottom: 12px;"></p>
      <button id="go-to-forgot" style="padding: 8px 16px; background: var(--color-primary); color: var(--color-on-primary); border: none; border-radius: 6px; cursor: pointer;">
        Request New Reset Link
      </button>
      <button id="go-to-login-error" style="margin-top: 8px; padding: 8px 16px; background: transparent; color: var(--color-muted-foreground); border: 1px solid var(--color-border); border-radius: 6px; cursor: pointer;">
        Go to Login
      </button>
    </div>
    
    <div id="success-section" style="display: none; text-align: center;">
      <div style="padding: 24px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="48" height="48" style="color: #4CAF50; margin-bottom: 16px;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        <h3 style="margin: 0 0 12px;">Password Updated!</h3>
        <p style="margin: 0 0 16px; color: var(--color-muted-foreground);">
          Your password has been successfully updated.
        </p>
        <button id="go-to-login-success" style="padding: 10px 20px; background: var(--color-primary); color: var(--color-on-primary); border: none; border-radius: 6px; cursor: pointer;">
          Go to Login
        </button>
      </div>
    </div>
  </div>
  
  <script is:inline>
    (function() {
      var token = null;
      var urlParams = new URLSearchParams(window.location.search);
      var tokenParam = urlParams.get('token');
      
      function showNoToken() {
        document.getElementById('token-section').style.display = 'none';
        document.getElementById('success-section').style.display = 'none';
        document.getElementById('error-token').style.display = 'none';
        document.getElementById('no-token').style.display = 'block';
      }
      
      function showInvalidToken(errorMsg) {
        document.getElementById('token-section').style.display = 'none';
        document.getElementById('success-section').style.display = 'none';
        document.getElementById('no-token').style.display = 'none';
        document.getElementById('error-token').style.display = 'block';
        document.getElementById('error-token-message').textContent = errorMsg;
      }
      
      function showSuccess() {
        document.getElementById('token-section').style.display = 'none';
        document.getElementById('success-section').style.display = 'block';
        document.getElementById('no-token').style.display = 'none';
        document.getElementById('error-token').style.display = 'none';
      }
      
      function handleError(msg) {
        var errorEl = document.getElementById('error');
        errorEl.style.display = 'block';
        errorEl.textContent = msg;
      }
      
      function validateResetToken(resetToken) {
        return fetch('/api/v1/auth/reset-token/' + resetToken, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' }
        }).then(function(response) {
          return response.json().then(function(data) {
            if (response.ok) {
              return { valid: true, email: data.email || null };
            } else {
              throw new Error(data.detail || 'Invalid or expired reset token');
            }
          });
        }).catch(function(err) {
          return { valid: false, error: err.message };
        });
      }
      
      function handleReset() {
        if (!tokenParam) {
          showNoToken();
          return;
        }
        
        token = tokenParam;
        document.getElementById('token-section').style.display = 'block';
        
        validateResetToken(token).then(function(result) {
          if (!result.valid) {
            showInvalidToken(result.error || 'The reset link is invalid or has expired.');
          }
        });
        
        var form = document.getElementById('reset-form');
        
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          
          var password = document.getElementById('password').value;
          var confirmPassword = document.getElementById('confirmPassword').value;
          
          if (password !== confirmPassword) {
            handleError('Passwords do not match');
            return;
          }
          
          if (password.length < 8) {
            handleError('Password must be at least 8 characters');
            return;
          }
          
          fetch('/api/v1/auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              token: token,
              new_password: password,
              confirm_password: confirmPassword
            })
          }).then(function(response) {
            return response.json();
          }).then(function(data) {
            if (data.success) {
              showSuccess();
            } else {
              handleError(data.message || 'Password reset failed');
            }
          }).catch(function(err) {
            handleError('Request failed. Please try again.');
          });
        });
      }
      
      document.getElementById('go-to-login').addEventListener('click', function() {
        window.location.href = '/login';
      });
      
      document.getElementById('go-to-forgot').addEventListener('click', function() {
        window.location.href = '/forgot-password';
      });
      
      document.getElementById('go-to-login-error').addEventListener('click', function() {
        window.location.href = '/login';
      });
      
      document.getElementById('go-to-login-success').addEventListener('click', function() {
        window.location.href = '/login';
      });
      
      showNoToken();
      handleReset();
    })();
  </script>
</body>
</html>