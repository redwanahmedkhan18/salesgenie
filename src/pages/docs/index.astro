---
import Layout from "../../layouts/Layout.astro";
export const prerender = false;
---

<Layout title="SalesGenie API Documentation">
  <div class="min-h-screen bg-slate-900 text-white">
    <!-- Navbar -->
    <nav class="sticky top-0 bg-black/95 backdrop-blur-md border-b border-white/10 px-6 py-4 z-50">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href="/" class="text-2xl font-bold text-orange-400">SalesGenie Docs</a>
        <a href="/login" class="bg-orange-500 hover:bg-orange-600 text-black font-semibold px-4 py-2 rounded-lg transition-colors">Get Started</a>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="px-6 lg:px-8 py-12 lg:py-20 text-center">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">
          API Documentation
        </h1>
        <p class="text-lg text-gray-300 mb-8">
          FAANG-level API documentation for AI-powered sales and support automation.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#quickstart" class="px-6 py-3 rounded-lg bg-orange-500 hover:bg-orange-600 font-semibold transition-colors">
            Quickstart
          </a>
          <a href="/api/v1/docs" class="px-6 py-3 rounded-lg border border-white/20 hover:bg-white/5 transition-colors">
            OpenAPI Reference
          </a>
        </div>
      </div>
    </section>

    <!-- Quickstart Section -->
    <section id="quickstart" class="px-6 lg:px-8 py-12 lg:py-20 border-t border-white/10">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold mb-6 text-center">Quickstart Guide</h2>
        <p class="text-center text-gray-400 mb-10">Get your first AI agent running in minutes</p>
        
        <div class="grid md:grid-cols-3 gap-6">
          <div class="border border-white/10 rounded-xl p-6 hover:bg-white/5 transition-colors">
            <div class="text-3xl font-bold text-orange-400 mb-2">1</div>
            <h3 class="font-bold mb-3">Create Account</h3>
            <p class="text-gray-400 text-sm mb-4">Sign up and get your API key instantly</p>
            <code class="text-xs bg-white/5 px-3 py-2 rounded-md">POST /api/v1/auth/signup</code>
          </div>
          
          <div class="border border-white/10 rounded-xl p-6 hover:bg-white/5 transition-colors">
            <div class="text-3xl font-bold text-orange-400 mb-2">2</div>
            <h3 class="font-bold mb-3">Configure Agent</h3>
            <p class="text-gray-400 text-sm mb-4">Set up your AI agent with system prompts</p>
            <code class="text-xs bg-white/5 px-3 py-2 rounded-md">POST /api/v1/agents</code>
          </div>
          
          <div class="border border-white/10 rounded-xl p-6 hover:bg-white/5 transition-colors">
            <div class="text-3xl font-bold text-orange-400 mb-2">3</div>
            <h3 class="font-bold mb-3">Go Live</h3>
            <p class="text-gray-400 text-sm mb-4">Deploy to production with one click</p>
            <code class="text-xs bg-white/5 px-3 py-2 rounded-md">POST /api/v1/deploy</code>
          </div>
        </div>
      </div>
    </section>

    <!-- Endpoints Section -->
    <section id="endpoints" class="px-6 lg:px-8 py-12 lg:py-20 border-t border-white/10">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold mb-6 text-center">Available Endpoints</h2>
        <p class="text-center text-gray-400 mb-10">All endpoints follow RESTful conventions</p>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="border border-white/10 rounded-xl p-6 hover:bg-white/5 transition-colors">
            <h3 class="font-bold text-lg mb-4">Authentication</h3>
            <ul class="space-y-2 text-sm">
              <li><span class="inline-block px-2 py-0.5 rounded text-xs bg-green-900/30 text-green-300">POST</span> <code class="text-gray-300"> /auth/login</code> - User login</li>
              <li><span class="inline-block px-2 py-0.5 rounded text-xs bg-green-900/30 text-green-300">POST</span> <code class="text-gray-300"> /auth/refresh</code> - Refresh tokens</li>
              <li><span class="inline-block px-2 py-0.5 rounded text-xs bg-green-900/30 text-green-300">GET</span> <code class="text-gray-300"> /auth/me</code> - Get current user</li>
            </ul>
          </div>
          
          <div class="border border-white/10 rounded-xl p-6 hover:bg-white/5 transition-colors">
            <h3 class="font-bold text-lg mb-4">AI Agents</h3>
            <ul class="space-y-2 text-sm">
              <li><span class="inline-block px-2 py-0.5 rounded text-xs bg-green-900/30 text-green-300">POST</span> <code class="text-gray-300"> /agents</code> - Create agent</li>
              <li><span class="inline-block px-2 py-0.5 rounded text-xs bg-green-900/30 text-green-300">GET</span> <code class="text-gray-300"> /agents/{"{id}"}</code> - Get agent</li>
              <li><span class="inline-block px-2 py-0.5 rounded text-xs bg-green-900/30 text-green-300">POST</span> <code class="text-gray-300"> /agents/{"{id}"}/run</code> - Execute agent</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="px-6 lg:px-8 py-12 lg:py-20 border-t border-white/10">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-10">Production Stats</h2>
        <div class="grid sm:grid-cols-3 gap-8">
          <div>
            <div class="text-4xl font-bold text-orange-400">10M+</div>
            <div class="text-gray-400">Active Users</div>
          </div>
          <div>
            <div class="text-4xl font-bold text-orange-400">500k+</div>
            <div class="text-gray-400">Concurrent Connections</div>
          </div>
          <div>
            <div class="text-4xl font-bold text-orange-400">99.99%</div>
            <div class="text-gray-400">Uptime SLA</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="px-6 lg:px-8 py-8 border-t border-white/10">
      <div class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-4">
        <div class="text-sm text-gray-400">
          <span id="current-year">© 2026</span> SalesGenie. All rights reserved.
        </div>
        <div class="flex gap-6 text-sm text-gray-400">
          <a href="#" class="hover:text-white transition-colors">Privacy</a>
          <a href="#" class="hover:text-white transition-colors">Terms</a>
          <a href="#" class="hover:text-white transition-colors">Security</a>
        </div>
      </div>
    </footer>
    
    <script is:inline>
      const yearEl = document.getElementById('current-year');
      if (yearEl) {
        yearEl.textContent = '© ' + new Date().getFullYear();
      }
    </script>
  </div>
</Layout>