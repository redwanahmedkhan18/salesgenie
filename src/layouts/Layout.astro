---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  openGraph?: {
    type?: string;
    image?: string;
    url?: string;
  };
}

const {
  title = "SalesGenie — Enterprise AI Customer Support & Sales Agent Platform",
  description =
    "AI-powered multi-agent platform for customer support, sales automation, and enterprise knowledge management. 99.99% uptime, 500k concurrent connections.",
  canonical,
  openGraph = {},
} = Astro.props;

const url = "https://salesgenie.ai";
const defaultImage = "https://salesgenie.ai/og-image.png";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SalesGenie",
  description,
  url,
  potentialAction: {
    "@type": "SearchAction",
    target: `${url}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7a501" />
    <meta name="color-scheme" content="light dark" />

    <!-- Security -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />


    <!-- Canonical -->
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={openGraph.type ?? "website"} />
    <meta property="og:image" content={openGraph.image ?? defaultImage} />
    <meta property="og:url" content={openGraph.url ?? url} />
    <meta property="og:site_name" content="SalesGenie" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={openGraph.image ?? defaultImage}
    />
    <meta name="twitter:site" content="@salesgenie" />
    <meta name="twitter:creator" content="@salesgenie" />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Performance -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//api.groq.com" />
  </head>

  <body>
    <slot />

    <script is:inline>
      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          document.dispatchEvent(
            new CustomEvent("open-command-palette")
          );
        }
      });
    </script>
  </body>
</html>