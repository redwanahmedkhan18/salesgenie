[tool.bandit]
namespace = "salesgenie"
exclude_dirs = [
    ".git",
    "__pycache__",
    "node_modules",
    "venv",
    ".venv",
    "build",
    "dist",
    "migrations",
    "migrations/versions",
]
skips = [
    "B104",  # hardcoded_bind_all_interfaces - acceptable for Docker containers
    "B105",  # hardcoded_password_string - handled by secret scanning
]
tests = [
    "B101",  # assert_used
    "B102",  # exec_builtins
    "B105",  # hardcoded_password_string
    "B106",  # hardcoded_password_funcarg
    "B107",  # hardcoded_password_default
    "B110",  # try_except_pass
    "B111",  # hardcoded_ssl_key
    "B301",  # pickle
    "B302",  # marshal
    "B307",  # eval
    "B311",  # random
    "B403",  # import_pickle
    "B404",  # import_subprocess
    "B601",  # paramiko
    "B602",  # subprocess_popen_with_shell
    "B603",  # subprocess
    "B604",  # any_other_function_with_shell
    "B608",  # hardcoded_sql_expressions
]
