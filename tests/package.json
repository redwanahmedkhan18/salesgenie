{
  "name": "salesgenie-tests",
  "version": "1.0.0",
  "description": "SalesGenie Testing Suite",
  "scripts": {
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "playwright test",
    "test:load": "locust -f tests/load-tests/locustfile.py",
    "test:security": "python -m pytest tests/security/ -v",
    "test:performance": "locust -f tests/load-tests/locustfile.py --headless -u 100 -r 10 --run-time 5m",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:unit && npm run test:integration",
    "test:report": "jest --coverage --coverage-reporters=text --coverage-reporters=lcov"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "locust": "^2.15.1",
    "faker": "^8.0.2",
    "pytest": "^8.0.0",
    "pytest-asyncio": "^0.23.0",
    "pytest-cov": "^4.1.0",
    "httpx": "^0.25.0"
  }
}