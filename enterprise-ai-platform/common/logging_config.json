{
  "version": 1,
  "disable_existing_loggers": false,
  
  "filters": {
    "sensitive_data_filter": {
      "()": "enterprise_ai_platform.common.logging.SensitiveDataFilter"
    }
  },
  
  "formatters": {
    "json": {
      "()": "enterprise_ai_platform.common.logging.JSONFormatter",
      "service_name": "salesgenie"
    }
  },
  
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "json",
      "stream": "ext://sys.stdout",
      "filters": ["sensitive_data_filter"]
    },
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "/var/log/salesgenie/salesgenie.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "filters": ["sensitive_data_filter"]
    }
  },
  
  "loggers": {
    "enterprise_ai_platform": {
      "level": "DEBUG",
      "handlers": ["console", "file"],
      "propagate": false
    },
    "salesgenie": {
      "level": "DEBUG",
      "handlers": ["console", "file"],
      "propagate": false
    }
  },
  
  "root": {
    "level": "INFO",
    "handlers": ["console"]
  }
}
