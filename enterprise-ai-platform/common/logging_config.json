{
  "version": 1,
  "disable_existing_loggers": false,
  
  "filters": {
    "context_filter": {
      "()": "logging.Filter",
      "name": "add_context"
    },
    "sensitive_data_filter": {
      "()": "enterprise_ai_platform.common.logging.SensitiveDataFilter"
    }
  },
  
  "formatters": {
    "json": {
      "()": "enterprise_ai_platform.common.logging.JSONFormatter",
      "format": {
        "timestamp": "%(asctime)s",
        "level": "%(levelname)s",
        "service": "api-gateway",
        "request_id": "%(request_id)s",
        "user_id": "%(user_id)s",
        "trace_id": "%(trace_id)s",
        "message": "%(message)s",
        "module": "%(module)s",
        "function": "%(funcName)s",
        "line": "%(lineno)d",
        "duration_ms": "%(duration_ms)s",
        "context": "%(context)s"
      }
    }
  },
  
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "json",
      "stream": "ext://sys.stdout",
      "filters": ["context_filter", "sensitive_data_filter"]
    },
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "/var/log/salesgenie/api-gateway.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "filters": ["context_filter", "sensitive_data_filter"]
    }
  },
  
  "loggers": {
    "enterprise_ai_platform": {
      "level": "DEBUG",
      "handlers": ["console", "file"],
      "propagate": false
    }
  },
  
  "root": {
    "level": "INFO",
    "handlers": ["console"]
  }
}